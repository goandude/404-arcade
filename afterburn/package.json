{
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "esbuild": "^0.28.2",
    "three": "^0.186.0"
  },
  "name": "afterburn-coastal-canyon",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild main.js --bundle --format=iife --outfile=bundle.js --minify",
